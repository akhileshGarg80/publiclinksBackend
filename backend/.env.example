# Backend Server Port (Default: 5000)
PORT=5000

# Environment Mode
NODE_ENV=development

# Main Domain for Subdomain Routing
MAIN_DOMAIN=localhost

# Frontend Client URL
FRONTEND_URL=http://localhost:3000

# Backend Base URL
BACKEND_URL=http://localhost:5000

# Allowed CORS Origins (* for development or comma-separated URLs)
CORS_ORIGIN=*

# MongoDB Connection String (Atlas or Local)
# If left blank or unset, the system automatically uses the active in-memory store!
MONGODB_URI=

# JWT Secret Key for Owner Edit Sessions
JWT_SECRET=your_super_secret_jwt_key_2026

# JWT Expiration Duration
JWT_EXPIRES_IN=2h

# (Optional) ImgBB API Key for external image hosting
IMGBB_API_KEY=
