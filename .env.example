# ==============================================================================
# Business Profile Platform - Environment Variables
# ==============================================================================

# Server Port (Default is 3000)
PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Connection String (Atlas SRV or Local Mongo URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/business_profiles?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/business_profiles?retryWrites=true&w=majority

# ImgBB API Key (For Image Uploads / Proxy)
IMGBB_API_KEY=your_imgbb_api_key_here

# JWT Secret for Edit Sessions
JWT_SECRET=super_secret_jwt_key_business_profile_platform_2026_secure

# Token Expiry (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=2h

# Domain & CORS Configuration
MAIN_DOMAIN=yourdomain.com
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=*
